{
  "name": "@ga-harness/desktop",
  "private": true,
  "version": "0.0.1",
  "description": "GenericAgent-Harness desktop shell: Electron window around the ui-web backend",
  "author": "Fwind43",
  "homepage": "https://github.com/Fwind43/GenericAgent-Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fwind43/GenericAgent-Harness.git"
  },
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/backend.js && node --check src/preload.js && node --check src/updater.js && node --check src/autostart.js && node --check scripts/prepare.mjs",
    "prepare:resources": "node scripts/prepare.mjs",
    "dist": "node scripts/prepare.mjs && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.fwind43.ga-harness",
    "productName": "GenericAgent-Harness",
    "executableName": "ga-harness-desktop",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "src/**",
      "resources/icon.png",
      "resources/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/python",
        "to": "python"
      },
      {
        "from": "stage/py",
        "to": "py"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "executableName": "ga-harness-desktop",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Fwind43",
        "repo": "GenericAgent-Harness",
        "releaseType": "draft"
      }
    ]
  },
  "desktopName": "ga-harness-desktop.desktop"
}
